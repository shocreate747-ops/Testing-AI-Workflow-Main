# ── Google Sheets ──────────────────────────────────────────────────────────────
# The long ID from your sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=1tmvW5StFGdPN-Yw-gZOWMlpCbYbqj2ydvkzlAFfFqYY

# The tab name in your sheet — set this to the exact tab name (e.g. Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Full JSON content of your Google service account key file
# (Google Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Frame.io ───────────────────────────────────────────────────────────────────
# Webhook secret from Frame.io → Developer → Webhooks
FRAMEIO_WEBHOOK_SECRET=your_frameio_webhook_secret

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
